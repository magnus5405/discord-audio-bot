# Default settings can be configured here in the .env, but all 
# settings can be overridden by settings.json generated from the TUI.

# Discord Bot token, found in the Discord developer portal
DISCORD_TOKEN=your_discord_bot_token_here

# Discord server id, found by right clicking the server and copying the ID
DISCORD_SERVER_ID=your_discord_server_id_here

# Google Gemini API
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud Speech-to-Text
# v1 uses only a Cloud API key.
GOOGLE_STT_SPEECH_BACKEND=v1
GOOGLE_STT_API_KEY=your_cloud_api_key_here

# If GOOGLE_STT_SPEECH_BACKEND is set to v2, use a service account JSON
# and Cloud project/location/model settings
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
# GOOGLE_STT_PROJECT_ID=your_gcp_project_id_here
# GOOGLE_STT_LOCATION=eu
# GOOGLE_STT_MODEL=chirp_3

# ElevenLabs TTS (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Estimated USD rates for live session costs
ELEVENLABS_USD_PER_1K_CHARACTERS=0.1
GENAI_USD_PER_1M_INPUT_TOKENS=0.25
GENAI_USD_PER_1M_OUTPUT_TOKENS=1.5
GOOGLE_STT_USD_PER_MINUTE=0.016

# Silence duration before bot replies
BOT_REPLY_SILENCE_SECONDS=5
# Cooldown duration after bot replies before it can reply again after silence
BOT_REPLY_COOLDOWN_SECONDS=180
# Maximum time before starting to respond after being metioned, unless silence
BOT_MENTION_WINDOW_SECONDS=30
# Optional reply language override (BCP-47). Leave blank to follow STT primary language.
# BOT_REPLY_LANGUAGE=en-US
# If the bot should greet users when it joins and others enters the channel mid-session.
BOT_GREET_ON_JOIN=true

# Debug mode to enable verbose logging
DEBUG_MODE=false

# Optional log file when using the Textual TUI
# TUI_LOG_FILE=logs/tui.log
